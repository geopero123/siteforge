NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy fallback.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional read-only token for private GitHub repos. Never sent to browser.
GITHUB_TOKEN=
# Repositories allowed to use the private worker token, comma-separated.
GITHUB_REPOSITORIES=
# Supabase user UUID permitted to use the private worker token.
GITHUB_TOKEN_USER_ID=
# Optional token for everyone else's public repositories. Create a fine-grained
# token with "Public repositories (read-only)" only; it raises GitHub's limit
# from 60 to 5,000 requests an hour. Private repositories are refused with it.
GITHUB_PUBLIC_TOKEN=
# Only isolated development: lets the worker scan local fixture sites.
ALLOW_LOCAL_AUDITS=false
# Explicit acknowledgement of network isolation for public/untrusted scans.
AUDIT_EGRESS_ISOLATED=false
WORKER_POLL_MS=2000
# Upper bound on Gemini calls per audit (screenshots, missions, code review).
AI_MAX_CALLS_PER_AUDIT=60
# AI code review batches per repository scan (about 40k characters each).
REPO_REVIEW_MAX_BATCHES=8
# Payments are activated separately in billing_settings after verifying setup.
# Use test-mode keys and prices first. Never expose the secret key to the browser.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SINGLE_PRICE_ID=
STRIPE_MONTHLY_PRICE_ID=
